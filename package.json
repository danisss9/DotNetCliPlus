{
  "name": "dotnet-cli-plus",
  "displayName": "DotNet CLI Plus",
  "description": "dotnet CLI commands, project/solution management, NuGet tools and templates for VS Code — a free companion to the base C# extension",
  "repository": "https://github.com/danisss9/DotNetCliPlus",
  "publisher": "danisss9",
  "version": "1.1.0",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "recommendations": [
    "ms-dotnettools.vscode-dotnet-runtime",
    "ms-dotnettools.csharp",
    "github.copilot",
    "anthropic.claude-code"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dotnet-cli-plus.runProject",
        "title": ".NET: Run Project",
        "category": "DotNet CLI Plus"
      },
      {
        "command": "dotnet-cli-plus.debugProject",
        "title": ".NET: Debug Project",
        "category": "DotNet CLI Plus"
      },
      {
        "command": "dotnet-cli-plus.watchProject",
        "title": ".NET: Watch Project",
        "category": "DotNet CLI Plus"
      },
      {
        "command": "dotnet-cli-plus.buildTarget",
        "title": ".NET: Build",
        "category": "DotNet CLI Plus"
      },
      {
        "command": "dotnet-cli-plus.rebuildTarget",
        "title": ".NET: Rebuild",
        "category": "DotNet CLI Plus"
      },
      {
        "command": "dotnet-cli-plus.cleanTarget",
        "title": ".NET: Clean",
        "category": "DotNet CLI Plus"
      },
      {
        "command": "dotnet-cli-plus.restoreSolution",
