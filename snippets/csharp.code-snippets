{
	"Auto-implemented property": {
		"prefix": "prop",
		"body": [
			"public ${1:type} ${2:Name} { get; set; }"
		],
		"description": "Auto-implemented property with get and set"
	},
	"Read-only auto property": {
		"prefix": "propg",
		"body": [
			"public ${1:type} ${2:Name} { get; private set; }"
		],
		"description": "Auto-implemented property with private set"
	},
	"Full property with backing field": {
		"prefix": "propfull",
		"body": [
			"private ${1:type} _${2:name};",
			"",
			"public ${1:type} ${3:Name}",
			"{",
			"    get { return _${2:name}; }",
			"    set { _${2:name} = value; }",
			"}"
		],
		"description": "Property with explicit backing field"
	},
	"Constructor": {
		"prefix": "ctor",
